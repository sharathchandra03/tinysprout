# ============================================================================
# RTBW CMS — Environment Variables
# Copy this file to ".env" for local development, and set the same variables
# in the Render dashboard (Environment tab) for production.
# NEVER commit the real .env file or real secret values.
# ============================================================================

# ---- Persistent database (REQUIRED) ----------------------------------------
# Supabase Postgres connection string.
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the Connection Pooler URI for Render (host ends in .pooler.supabase.com).
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Set to "disable" ONLY when connecting to a local Postgres without SSL.
# Leave unset on Supabase/Render — managed Postgres requires SSL.
# PGSSL=disable

# Keep the pool small on Supabase free tier / pooler.
PG_POOL_MAX=5

# ---- Image storage: Supabase Storage (REQUIRED) ----------------------------
# Your Supabase project URL (safe to expose — it's not a secret):
#   Supabase dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://<project-ref>.supabase.co

# SERVER-ONLY secret. Supabase dashboard -> Project Settings -> API ->
# Project API keys -> service_role. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage bucket name (must match the bucket you create in Supabase).
SUPABASE_BUCKET=website-images

# ---- Application -----------------------------------------------------------
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin login. Only used the first time the database is seeded.
ADMIN_EMAIL=admin@rtbw.com
ADMIN_PASSWORD=change-me

# Render sets PORT automatically; 3000 is the local default.
PORT=3000

# Set to "production" on Render so secure cookies are enabled.
NODE_ENV=production
